# electron-builder-squirrel-windows is a non-optional peer of app-builder-lib, but
# electron-builder only require()s it for the "squirrel" target, which we never build
# (see electron-builder.yml: nsis + portable). It drags in electron-winstaller -> temp
# -> rimraf@2 -> glob@7 -> minimatch@3 -> brace-expansion@1 (GHSA-mh99-v99m-4gvg), which
# has no patched release compatible with those callers. Skipping auto-installed peers
# keeps it out of the tree entirely.
legacy-peer-deps=true
