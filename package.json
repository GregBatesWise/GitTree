{
  "name": "git-desktop",
  "version": "0.6.0",
  "productName": "GitTree",
  "description": "A SourceTree-like Git desktop client built with Electron + React",
  "author": "GitTree",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "build:icon": "node scripts/generate-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "@electron/asar": "^4.2.1",
    "@electron/universal": "^3.0.6",
    "ejs": "^6.0.1"
  }
}
